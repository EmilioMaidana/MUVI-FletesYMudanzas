# =====================================================
# Fletea — environment variables (production)
# =====================================================
# Copiar a .env y completar con valores reales.
# .env NO debe commitearse al repo.

# ---- External APIs ----
GOOGLE_MAPS_API_KEY=AIza...
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# ---- URLs públicas (producción) ----
# Frontend (Vercel)
FLETEA_FRONTEND_URL=https://www.fletea.com.ar
# Backend webhook que MercadoPago llamará server-to-server
MERCADOPAGO_NOTIFICATION_URL=https://api.fletea.com.ar/api/payments/webhook

# ---- CORS — orígenes permitidos por el backend ----
# Coma-separados. Acepta wildcards via setAllowedOriginPatterns.
CORS_ALLOWED_ORIGINS=https://www.fletea.com.ar,https://fletea.com.ar,https://*.vercel.app

# ---- Admin auth ----
# Cambiar SIEMPRE en producción.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<<password fuerte>>
JWT_SECRET=<<secreto aleatorio mínimo 32 caracteres>>

# ---- Postgres ----
DB_PASSWORD=<<password fuerte para la base>>

# ---- Email (Gmail SMTP) ----
# Usá una App Password de 16 caracteres (no la contraseña de Gmail).
# Pasos: Google Account → Seguridad → Verificación en 2 pasos (ON) → Contraseñas de aplicación
MAIL_USERNAME=fleteaflete@gmail.com
MAIL_PASSWORD=<<app-password-16-chars>>
